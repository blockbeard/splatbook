node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build
dist/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Host-specific compose override (e.g. atlas staging: localhost bind + env_file)
docker-compose.override.yml

# Local data
local.db
e2e-test.db*
*.log

# Playwright
/test-results
/playwright-report
/playwright/.cache

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Reference serving artifacts, generated from the committed document trees by
# `npm run build:pages` (wired into prebuild/predev). Derived like
# search-index.json, but ~4,500 files — checking them in would bury every
# content reimport in a diff nobody can read. See tools/build_pages.ts.
/static/content-packs/*/rules/nav.json
/static/content-packs/*/rules/nav-gm.json
/static/content-packs/*/rules/pages/

# In-repo git worktrees (parallel-session convention; see .prettierignore)
.worktrees/

# Sandbox scratch litter (see CLAUDE.md's no-unlink-mount note — files that
# couldn't be deleted outright get moved here instead; safe to rm for real
# from a normal filesystem)
.trash/

# Python bytecode cache (tools/build_rules.py, build_srd.py)
__pycache__/
*.pyc

# FUSE "sillyrename" leftovers from the no-unlink sandbox mount (in-place
# edits, e.g. `perl -pi`, leave these when the original can't be unlinked)
.fuse_hidden*

# Downloaded CI failure artifacts (gh run download / gh run view --log-failed)
e2e-artifacts/
e2e-failures.log

# D1 backups taken before a production deploy (docs/deployment.md's runbook puts
# them here, untracked). They are dumps of the live database — user rows, session
# rows, campaign contents — and this repo is public. Ignored so that no `git add
# -A` can ever sweep one in; a near miss on 2026-08-10 staged all five.
/prod-pre-*.sql
/*.db
